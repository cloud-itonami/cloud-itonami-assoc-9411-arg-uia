(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "compliance") 1
      (string=? candidate "education") 4
      (string=? candidate "energy") 1
      (string=? candidate "environment") 3
      (string=? candidate "governance") 6
      (string=? candidate "history") 4
      (string=? candidate "labor") 3
      (string=? candidate "membership") 2
      (string=? candidate "policy") 8
      (string=? candidate "research") 1
      (string=? candidate "sme") 1
      (string=? candidate "tax") 1
      (string=? candidate "trade") 2
      :else 0)
    0))

