;; The UIA source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljk from data/datascript-tx.edn.
;; So is the Clojure reading in src/association/facts.kotoba. The facts
;; are authored once, in the data file, and nowhere else; this one also
;; reaches the Kotoba oracle, wasm and both native ISAs. Do not hand-edit
;; either -- run the generator, and `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the Clojure reading. A set has no order and `topic`
;; is indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; The parity suite that used to compare these two files does not run in
;; this repository -- see the generator's header. `--check` replaces it:
;; both readings are regenerated and compared to what is on disk.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "uia"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 23 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 23)) false))

